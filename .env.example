# Set these in your Vercel project's Environment Variables (do not commit real values).

# Long random string used to sign session cookies. Generate with e.g.:
#   openssl rand -base64 48
SESSION_SECRET=

# One-time token required to create the first admin account via /setup.html.
# Set this before your first deploy, complete setup, then you may rotate or remove it.
SETUP_TOKEN=

# POSTGRES_URL (and friends) are set automatically when you attach a
# Postgres database to this project. No need to set manually.

# Blob store token/store id are set automatically when you attach a Blob
# store to this project. No need to set manually.

# RapidAPI key for the Hotel Search app (booking-com15 API on RapidAPI).
# Subscribe to the free tier, then paste the X-RapidAPI-Key value here.
RAPIDAPI_KEY=

# Anthropic API key for the Life Sim app. Create one (with billing set up,
# no free tier) at console.anthropic.com under Settings -> API Keys.
ANTHROPIC_API_KEY=
