# Set these in your Vercel project's Environment Variables (do not commit real values).

# Long random string used to sign session cookies. Generate with e.g.:
#   openssl rand -base64 48
SESSION_SECRET=

# One-time token required to create the first admin account via /setup.html.
# Set this before your first deploy, complete setup, then you may rotate or remove it.
SETUP_TOKEN=

# POSTGRES_URL (and friends) are set automatically when you attach a
# Vercel Postgres database to this project. No need to set manually.
